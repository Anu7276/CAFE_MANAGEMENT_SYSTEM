# ==============================================================================
# CAFÉ EMERALD — CLIENT ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# Backend API and WebSocket Target URL
# Local Dev: http://localhost:5000/api
# Production: https://api.yourcafe.com/api
VITE_API_URL=http://localhost:5000/api

# Client Error Monitoring (Sentry)
# Format: https://<KEY>@o<ORG>.ingest.sentry.io/<PROJECT>
VITE_SENTRY_DSN=
