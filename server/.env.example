# ==============================================================================
# CAFÉ EMERALD — BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# 1. APPLICATION RUNTIME
NODE_ENV=development                       # 'development' | 'staging' | 'production'
PORT=5000                                  # Internal HTTP listening port
TRUST_PROXY=1                              # 1 behind Render, Railway, Nginx, Cloudflare

# 2. SECURITY KEYS & TOKENS (MUST be >= 32 chars in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_32_char_cryptographic_jwt_secret_in_prod_2026
TABLE_SIGNING_SECRET=replace_with_32_char_hmac_secret_for_table_qr_tokens

# 3. DATABASE (MongoDB Atlas in Production)
# Local: mongodb://localhost:27017/cafe_emerald
# Atlas: mongodb+srv://<USER>:<PASS>@cluster0.xxxx.mongodb.net/cafe_emerald?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/cafe_emerald

# 4. MULTI-INSTANCE REDIS CACHE & WEBSOCKET PUB/SUB
# Optional in dev; recommended in production for multi-instance scaling
REDIS_URL=redis://localhost:6379

# 5. FRONTEND & DOMAIN CORS / SIBLING SUBDOMAINS
CLIENT_URL=http://localhost:5173           # Frontend Origin (e.g. https://order.yourcafe.com)
PUBLIC_URL=http://localhost:5173           # Public base URL for QR code links

# Sibling Subdomains Cookie Configuration (Recommended for Production)
# Set to parent domain (e.g. '.yourcafe.com') when frontend is order.yourcafe.com and API is api.yourcafe.com
# Enables SameSite=Lax httpOnly cookies shared across subdomains.
# Leave empty ONLY if frontend and backend use entirely different TLDs (fallback SameSite=None mode).
COOKIE_DOMAIN=.yourcafe.com

# 6. INITIAL OWNER ACCOUNT SEEDING
# Strictly required in production during first seed run
ADMIN_EMAIL=admin@cafeemerald.com
ADMIN_PASSWORD=DevAdmin@Emerald2026        # >= 8 chars, strictly secret in prod

# 7. BUSINESS DETAILS (Editable in Admin Panel)
CAFE_NAME="Café Emerald"
CAFE_TAGLINE="Artisanal Coffee & Gourmet Bakery"
CAFE_GSTIN=""                              # 15-character legal GSTIN
CAFE_FSSAI=""                              # 14-digit legal FSSAI License Number
CAFE_ADDRESS="Ground Floor, Emerald Heights, MG Road, Pune, Maharashtra 411001"
CAFE_PHONE="+91 98765 43210"

# 8. CLOUDINARY CLOUD STORAGE (Production Dish Images)
# Sign up at: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 9. RAZORPAY UPI & CARD PAYMENTS
# Sign up at: https://dashboard.razorpay.com/
# Test Mode prefix: rzp_test_... | Live Mode prefix: rzp_live_...
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                   # Secret for signature verification on /api/payments/webhook

# 10. ERROR MONITORING (Sentry)
# Sign up at: https://sentry.io/
SENTRY_DSN=
